{
    "name": "dmstr/php-bc4-client",
    "description": "Modern PHP client for Basecamp 4 (BC3 API) — OAuth 2.0 with refresh-token rotation",
    "type": "library",
    "license": "MIT",
    "keywords": ["basecamp", "basecamp4", "bc3-api", "api", "client", "oauth"],
    "authors": [
        {
            "name": "herzog kommunikation GmbH",
            "email": "info@herzogkommunikation.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/http-client": "^7.0",
        "symfony/http-client-contracts": "^3.0",
        "psr/http-client": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Dmstr\\Bc4Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmstr\\Bc4Client\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
